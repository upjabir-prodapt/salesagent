# Copy to .env for local development: cp .env.example .env
# Cloud Run: mount as /secrets/.env and set IS_LOCAL=0

# Application
APP_NAME=Sales Research API
APP_VERSION=1.0.0
API_PREFIX=/api/sales/v1
DEBUG=True
IS_LOCAL=True
HOST=0.0.0.0
PORT=8086
WORKERS=1
LOG_LEVEL=DEBUG
# LOG_FILE mirrors all application logs (retry, validation, pipeline). Agent model output is separate.
LOG_FILE=out/latest/app.log
AGENT_EVENT_LOG_VERBOSE=true
# AGENT_EVENT_LOG_FILE captures ADK agent text/tool events only (PlanReAct stream).
AGENT_EVENT_LOG_FILE=out/latest/agent.log
APP_ROLE=worker
API_USE_BACKGROUND_PIPELINE=false

# Cloud Tasks (when API_USE_BACKGROUND_PIPELINE=false)
CLOUD_TASKS_PROJECT=gclt-aicoe-dev-st
CLOUD_TASKS_LOCATION=europe-west3
CLOUD_TASKS_QUEUE=research-jobs
CLOUD_TASKS_WORKER_URL=http://localhost:8086/internal/tasks/research
CLOUD_TASKS_OIDC_SERVICE_ACCOUNT=
CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=3600
WORKER_OIDC_AUDIENCE=
WORKER_SKIP_OIDC_VERIFICATION=true 

# Google Cloud
GOOGLE_CLOUD_PROJECT=gclt-aicoe-dev-st
# GOOGLE_CLOUD_LOCATION anchors project-scoped infra (Cloud Tasks queue,
# GCS bucket, BigQuery-adjacent defaults) -- matches CLOUD_TASKS_LOCATION.
GOOGLE_CLOUD_LOCATION=europe-west3
# VERTEX_AI_LOCATION is the region Gemini inference actually runs in / is
# priced in (see pricing_catalog.json: gemini-3.5-flash @ europe-west3).
# Independent of GOOGLE_CLOUD_LOCATION -- see settings.vertex_ai_location.
VERTEX_AI_LOCATION=europe-west3
GOOGLE_GENAI_USE_VERTEXAI=true

# BigQuery
BIGQUERY_DATASET=sales_agent_jobs
BIGQUERY_TABLE=research_requests
BIGQUERY_COST_ATTRIBUTION_TABLE=cost_attribution
BIGQUERY_AGENT_TELEMETRY_TABLE=agent_telemetry
BIGQUERY_USER_FEEDBACK_TABLE=users_feedback

# Firestore (search query cache)
FIRESTORE_DATABASE=(default)
FIRESTORE_SEARCH_CACHE_COLLECTION=search_cache

# Redis (search query cache & content store)
# Memorystore/Redis for gclt-aicoe-dev-st is deliberately deferred (not
# provisioned -- see AICOE-Terraform GAP-REGISTER "Deliberately deferred, not
# gaps"). The old aicoesandox-vpc Memorystore IP this used to point at is
# unreachable from gclt-aicoe-dev-st's own VPC anyway. Left empty; every
# RedisRepository method wraps in try/except, so the search cache degrades
# gracefully without it. Set once Memorystore is provisioned.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=true
REDIS_TLS_VERIFY_CERT=false
REDIS_KEY_PREFIX=salesagent:search:
SEARCH_CACHE_BACKEND=redis
SEARCH_CACHE_TTL_SECONDS=604800
SEARCH_CONCURRENCY_LIMIT=8
TOTAL_KEYWORD_BUDGET=30

# GCS
GCS_BUCKET_NAME=gclt-aicoe-dev-st-sales-agent
GCS_PARENT_FOLDER=salesagent_response
GCS_SIGNED_URL_EXPIRATION_HOURS=1

# CORS (JSON arrays)
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Apigee -- these settings are irrelevant to the worker role (Apigee only
# ever calls the API service) but the shared Settings model requires them
# whenever IS_LOCAL=false; kept here for parity with .env.api.local.
APIGEE_RUNTIME_SA_EMAIL=apigee-int-runtime@gclt-aicoe-dev-apigee.iam.gserviceaccount.com
CLOUD_RUN_SERVICE_URL=https://sales-agent-api-xxxxx.run.app

# LLM gateway -- the worker makes the actual genai.Client() calls
# (src/worker/model.py, src/worker/agents/search.py), so these matter here.
# Disabled until the `llm` Apigee proxy exists (GAP-REGISTER R-08) and
# GoogleSearch grounding is verified through it (WS-E4).
LLM_GATEWAY_ENABLED=false
LLM_GATEWAY_BASE_URL=https://llm.aicoedev-int.colt.net
LLM_GATEWAY_API_KEY_SECRET=
PROMPT_TEMPLATE_VERSION=v1.0

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=sales-agent-api
# COMMIT_SHA: set by CI/Cloud Run env only (not in .env) — see settings.commit_sha
# Cloud Trace OTLP (HTTP/protobuf — otel_setup.py uses OTLPSpanExporter HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.name=sales-agent-api,gcp.project_id=gclt-aicoe-dev-st,deployment.environment=dev
GOOGLE_CLOUD_QUOTA_PROJECT=gclt-aicoe-dev-st
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Mounted Assets (pricing catalog, Colt product catalog)
# Cloud Run: mounted volume at /secrets/assets. Local: defaults to data/ or assets/
ASSETS_ROOT=
PRICING_CATALOG_FILENAME=pricing_catalog.json
COLT_CATALOG_FILENAME=ColtProductCatalog.pdf

# LLM Models (Model metadata & regional pricing loaded dynamically from pricing_catalog.json)
LLM_MODEL=gemini-3.5-flash
SEARCH_MODEL=gemini-3.5-flash

# Reliability & Retries
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY=5
GEMINI_RETRY_MAX_DELAY=120
GEMINI_RETRY_EXP_BASE=2
GEMINI_RETRY_JITTER=1
GEMINI_RETRY_STATUS_CODES=[408,429,500,502,503,504]
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_WAIT_FIXED=2
JOB_ID_PREFIX=job_
RESEARCH_STATUS_MIN_UPDATE_INTERVAL_SECONDS=5.0
RESEARCH_INIT_STEP_LABEL=Initializing research
RESEARCH_INIT_PROGRESS=5
RESEARCH_UPLOAD_STEP_LABEL=Uploading artifacts
RESEARCH_UPLOAD_PROGRESS=92
RESEARCH_EVAL_STEP_LABEL=Running quality evaluation
RESEARCH_EVAL_PROGRESS=97

# ADK Event Compaction
AGENT_EVENTS_COMPACT_ENABLED=true
AGENT_EVENTS_COMPACT_TOKEN_THRESHOLD=100000
AGENT_EVENTS_COMPACT_RETENTION=6
AGENT_EVENTS_COMPACT_INTERVAL=3
AGENT_EVENTS_COMPACT_OVERLAP=1

# Safety
SAFETY_HARASSMENT_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
SAFETY_HATE_SPEECH_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
SAFETY_SEXUAL_THRESHOLD=BLOCK_LOW_AND_ABOVE
SAFETY_DANGEROUS_THRESHOLD=BLOCK_ONLY_HIGH
SAFETY_LOGGING_ENABLED=True

# Output Guardrails
OUTPUT_GUARDRAIL_MIN_SECTIONS=8
OUTPUT_GUARDRAIL_MAX_RETRIES=2
OUTPUT_GUARDRAIL_HALLUCINATION_BLOCK_THRESHOLD=5

