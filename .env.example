# ============================================================================
# COLT-AI ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure with your actual values
# Never commit .env to version control
 
# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=Colt-AI Research API
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
WORKERS=1
 
# GOOGLE CLOUD CONFIGURATION
# ============================================================================
# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=cloud-practice-dev-2
# BigQuery Configuration
BIGQUERY_DATASET=colt_ingest
BIGQUERY_TABLE=research_requests
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Google Cloud Storage Configuration
GCS_BUCKET_NAME=colt-ai-usecase
GCS_AB_RESULTS_PATH=model_routing_config_20260310T114332Z.json
GCS_PARENT_FOLDER=salesagent_response
GOOGLE_GENAI_USE_VERTEXAI=true
BQ_DATASET_ID=colt_ingest
BQ_TABLE_ID=translation_jobs
#======================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
 
# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Valid levels: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# OPENTELEMETRY (ADK OTEL_TO_CLOUD STYLE)
# ============================================================================
# Master toggle for telemetry export.
OTEL_ENABLED=true
# Logical service name shown in traces/logs.
OTEL_SERVICE_NAME=sales-agent-api
# Direct OTLP endpoint for Cloud Trace (no collector).
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com
# OTLP protocol for the Python exporter stack.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Resource metadata used by traces/logs/metrics.
OTEL_RESOURCE_ATTRIBUTES=service.name=sales-agent-api,gcp.project_id=cloud-practice-dev-2,deployment.environment=local
# Optional for user-based ADC flows (avoid quota issues locally).
GOOGLE_CLOUD_QUOTA_PROJECT=cloud-practice-dev-2
# Enable OTel log auto-instrumentation to emit log records/events where supported.
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
# Use latest GenAI semantic conventions.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# Capture prompt/response as events rather than oversized span attributes.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
# ADK setting to prevent adding prompt/response bodies as span attributes.
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
# Optional multimodal prompt/response capture to GCS (enable when needed).
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://your-bucket/otel-genai
 
# ============================================================================
# RESEARCH CONFIGURATION
# ============================================================================
# Gemini model to use for research
GEMINI_MODEL="gemini-2.5-pro"
 
# ============================================================================
# SAFETY GUARDRAILS CONFIGURATION
# ============================================================================
# Harm categories to block
# Comma-separated list: HATE_SPEECH,DANGEROUS_CONTENT,SEXUALLY_EXPLICIT,HARASSMENT
SAFETY_HARM_CATEGORIES=HATE_SPEECH,DANGEROUS_CONTENT,SEXUALLY_EXPLICIT,HARASSMENT
 
# Safety threshold (BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE)
SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
 
# Enable safety logging
SAFETY_LOGGING_ENABLED=True
 
# ============================================================================
# AGENT CONFIGURATION
# ============================================================================
# Number of retry attempts for agent execution
AGENT_RETRY_ATTEMPTS=5
 
# Delay between retries in seconds
AGENT_RETRY_WAIT_FIXED=2
#=============================================================================
# GEMINI TOEKN COST
#============================================================================
 
GEMINI_COST_PER_1K_INPUT_TOKENS=0.00125
GEMINI_COST_PER_1K_OUTPUT_TOKENS=0.005
PROMPT_TEMPLATE_VERSION=v1.0
 
 
TABLE_RECONSTRUCTION_MODEL="gemini-2.5-pro"
GEMINI_MODEL="gemini-2.5-pro"
FALLBACK_TRANSLATION_MODEL="gemini-2.5-pro"
DOMAIN_DETECTION_MODEL="gemini-2.0-flash"